# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# bd auto-exports its Dolt DB to JSONL on every command. Dolt is the
# source of truth (synced via `bd dolt push`); the JSONL files are
# local exports that create merge noise when committed.
.beads/issues.jsonl
.beads/beads.jsonl

# Signing material
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Claude Code
.claude/

# The native app: the project is generated from native/project.yml (just native-project)
/native/GrabberNative.xcodeproj/
/native/Build/
/native/GrabberNative.entitlements
/native/Widgets/GrabberWidgets.entitlements
/native/Share/GrabberShare.entitlements
/native/ContextCore/.build/

# What the retired React Native app left behind in old checkouts
node_modules/
.expo/
/ios/
lib/generated_version.ts
.native-build-sha
*.tsbuildinfo

# worktrees
.worktrees/


# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
tmp/

# Beads ad-hoc report exports (canonical data lives in .beads/beads.jsonl)
beads_report_*.md

# Beads / Dolt files (added by bd init)
.beads/proxieddb/



# The iPhone's hardware UDID for the native recipes (scripts/native/phone-udid.sh); the repo is public
scripts/native/phone-udid.local
scripts/native/ipad-udid.local

# Python bytecode (scripts/native/fake-bridge.py run by the smoke test)
__pycache__/
