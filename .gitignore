# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# bd auto-exports its Dolt DB to JSONL on every command. Dolt is the
# source of truth (synced via `bd dolt push`); the JSONL files are
# local exports that create merge noise when committed.
.beads/issues.jsonl
.beads/beads.jsonl

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Claude Code
.claude/

# typescript
*.tsbuildinfo

# generated native folders
# ios/ is committed (see deploy recipe in justfile) — stops expo prebuild from
# wiping DEVELOPMENT_TEAM and breaking expo-live-activity on every deploy.
/ios/Pods/
/ios/build/
/ios/.xcode.env.local
/ios/**/xcuserdata/
/android

# The native app: the project is generated from native/project.yml (just native-project)
/native/GrabberNative.xcodeproj/
/native/Build/
/native/GrabberNative.entitlements
/native/Widgets/GrabberWidgets.entitlements
/native/ContextCore/.build/

# worktrees
.worktrees/

# generated version file
lib/generated_version.ts

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
tmp/

# Beads ad-hoc report exports (canonical data lives in .beads/beads.jsonl)
beads_report_*.md

# Beads / Dolt files (added by bd init)
.beads/proxieddb/


# `just deploy` records the commit the phone carries; `just ota` checks the native surface against it
.native-build-sha

# The iPhone's hardware UDID for the native recipes (scripts/native/phone-udid.sh); the repo is public
scripts/native/phone-udid.local
scripts/native/ipad-udid.local

# Python bytecode (scripts/native/fake-bridge.py run by the smoke test)
__pycache__/
