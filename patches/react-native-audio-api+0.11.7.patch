+      -force_load #{lib_dir}/libogg.a
+      -force_load #{lib_dir}/libvorbis.a
+      -force_load #{lib_dir}/libvorbisenc.a
+      -force_load #{lib_dir}/libvorbisfile.a
+      -force_load #{lib_dir}/libssl.a
+      -force_load #{lib_dir}/libcrypto.a
+    ].join(" "),
